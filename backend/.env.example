PORT=5000
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/newshub?retryWrites=true&w=majority
JWT_SECRET=<random_string_min_32_chars>
JWT_EXPIRES_IN=7d

# NewsAPI.org — 100 req/day free — https://newsapi.org
NEWS_API_KEY=<your_newsapi_key>

# GNews API — 100 req/day free — https://gnews.io
# Supports Telugu (te) and Hindi (hi) natively
GNEWS_API_KEY=<your_gnews_key>

# MediaStack — 500 req/month free — https://mediastack.com
# 7,500+ sources, regional vernacular press
MEDIASTACK_API_KEY=<your_mediastack_key>

# NewsCatcher API — 100 req/day free — https://newscatcherapi.com
# 60,000+ sources, country + language filtering
NEWSCATCHER_API_KEY=<your_newscatcher_key>

# The Guardian API — 500 req/day free — https://open-platform.theguardian.com
GUARDIAN_API_KEY=<your_guardian_key>

# NewsData.io — 200 req/day free — https://newsdata.io
# Hindi + Telugu native support, country=IN, date filtering
NEWSDATA_API_KEY=<your_newsdata_key>

# Currents API — 600 req/day free — https://currentsapi.services
# 60+ languages, real-time + date range
CURRENTS_API_KEY=<your_currents_api_key>

# TheNewsAPI — 100 req/day free — https://www.thenewsapi.com
# Categories, date range, global sources
THENEWSAPI_KEY=<your_thenewsapi_key>

# World News API — 1000 req/day free — https://worldnewsapi.com
# Largest free quota, date range, multi-language
WORLD_NEWS_API_KEY=<your_worldnews_api_key>

CLIENT_URL=http://localhost:3000
